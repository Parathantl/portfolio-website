# PostgreSQL Database (existing container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=blog

# JWT Secret (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# URLs (use your Lightsail public IP or domain)
ALLOWED_ORIGINS=http://your-lightsail-ip
FRONTEND_URL=http://your-lightsail-ip

# Shared secret for on-demand ISR revalidation (backend -> frontend).
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=your-long-random-revalidate-secret

# Email Configuration (Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
CONTACT_EMAIL=your-email@gmail.com

# Storage Provider (local or cloudinary)
STORAGE_PROVIDER=local
APP_URL=https://parathan.com

# Cloudinary (only needed if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
